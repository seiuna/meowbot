# ─────────────────────────────────────────────────────────
# MeowBot Core — Environment Configuration
# ─────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control!
# ─────────────────────────────────────────────────────────

# ── Network Proxy ──────────────────────────────────────
# Used for all outbound HTTP requests (LLM API, web search, Puppeteer).
# Format: http://host:port
#HTTP_PROXY=http://127.0.0.1:7891

# ── MongoDB ─────────────────────────────────────────────
# Connection settings for the MongoDB database.
#MONGO_HOST=localhost
#MONGO_PORT=27017
#MONGO_DATABASE=meowbot
#MONGO_USERNAME=
#MONGO_PASSWORD=
#MONGO_AUTH_SOURCE=admin

# ── Embedding Service ───────────────────────────────────
# Enable vector search via Ollama or LM Studio.
# Set EMBEDDING_ENABLED=true and configure type/url/model.
#EMBEDDING_ENABLED=true              # default: true (from config.json)
#EMBEDDING_TYPE=ollama               # ollama | lmstudio
#EMBEDDING_URL=http://127.0.0.1:11434
#EMBEDDING_MODEL=gemma-embedding     # 768-dim. Alt: qwen3-embedding:0.6b (1024-dim)

# ── Puppeteer / Screenshot ──────────────────────────────
# Set HEADLESS=false to show browser window during screenshot capture.
#HEADLESS=true

# ── MCP Config ──────────────────────────────────────────
# Override the default MCP config path.
#MCP_CONFIG_PATH=config/mcp-config.json

# ── Logging ─────────────────────────────────────────────
# Log level: debug | info | warn | error
#LOG_LEVEL=info

# ── App Server ──────────────────────────────────────────
# App server port (default: 35023)
#APP_PORT=35023
